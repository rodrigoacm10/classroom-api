APP_NAME=Classroom API
APP_VERSION=0.1.0

# Credenciais alinhadas com docker-compose.yml
DATABASE_URL=postgresql+psycopg://classroom:classroom@localhost:5432/classroom
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Configurações de E-mail (Resend)
# Obtenha sua chave em https://resend.com
RESEND_API_KEY=re_123456789
# Durante testes sem domínio próprio, utilize "onboarding@resend.dev"
EMAIL_FROM=onboarding@resend.dev
FRONTEND_URL=http://localhost:3000
INVITE_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=15

# Firebase Cloud Messaging (FCM)
# Opção 1: Caminho do arquivo .json (Dev local)
FIREBASE_CREDENTIALS_PATH=credentials/firebase-service-account.json

# Opção 2: JSON inline minificado em 1 linha (Produção / Render / Railway / Heroku / CI-CD)
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"..."}'

# Celery (Opcional — por padrão usa o REDIS_URL acima)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Cloudflare R2 — Object Storage (evidências fotográficas)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=classroom-evidence
CLOUDFLARE_R2_PUBLIC_URL=

# Relatórios de frequência — estratégia de paralelismo de CPU
# sequential | process_pool | thread_pool_numpy
REPORT_STRATEGY=process_pool
# 0 = usar o nº de núcleos disponível no container (cpu_budget)
REPORT_MAX_WORKERS=0